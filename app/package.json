{
  "name": "whatsapp-summary-desktop",
  "version": "0.3.0-beta.1",
  "description": "Desktop shell for the WhatsApp summary bot: window, tray, autostart, engine supervisor",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/supervisor.test.js",
    "build:engine": "node ../scripts/build-engine.js",
    "dist": "npm run build:engine && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "electron@45.3.3": true
  },
  "author": "WhatsApp Summary",
  "build": {
    "appId": "app.whatsappsummary.desktop",
    "productName": "WhatsApp Summary",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "supervisor.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build",
        "to": ".",
        "filter": [
          "engine/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../public/app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsApp Summary",
      "runAfterFinish": true,
      "artifactName": "WhatsApp-Summary-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  }
}
