{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Summary",
  "mainBinaryName": "wa-summary-mobile",
  "version": "0.3.0",
  "identifier": "io.github.bnny5985.wasummary",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
